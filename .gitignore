# Environment files
.env
.env.*
.env.local
.env.production
.env.development
.env.staging
*.env

# Credentials & secrets
credentials.json
service-account-*.json
*-keys.json
secrets.yaml
secrets.yml
secrets.json
vault/*
*.p12
*.jks
*.keystore
id_ed25519*
id_rsa*
ssh_host_*_key
authorized_keys
known_hosts

# Token files
.token
tokens.txt
auth.json
aws-credentials
.env.secrets

# Terraform state (may contain secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!variables.tfvars

# Docker/compose overrides with secrets
docker-compose.override.yml
docker-compose.local.yml

# IDE & editor secrets
.vscode/*.secret*
.idea/*credentials*

# OS-generated files (often contain sensitive data)
.DS_Store
Thumbs.db
Desktop.ini
dotfiles/themes/.local/share/themes/adw-gtk3/

# Per-user files generated during setup or theme selection
dotfiles/hyprland/.config/hypr/colors.conf
dotfiles/hyprland/.config/hypr/config/colors.lua
