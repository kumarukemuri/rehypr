{
  "layer": "top",
  "output": ["eDP-1", "DP-2"],
  "margin-top": 0,
  "spacing": 6,
  "modules-center": ["group/clockmenu"],
  "group/clockmenu": {
    "orientation": "horizontal",
    "drawer": {
      "children-class": "clock_drawer",
      "transition-duration": 10,
      "transition-left-to-right": true,
      "click-to-reveal": true,
    },
    "modules": ["clock", "group/controls#control_elements"],
  },
  "group/controls#control_elements": {
    "orientation": "horizontal",
    "modules": ["group/status", "tray", "battery"],
  },
  "group/status": {
    "orientation": "horizontal",
    "modules": ["privacy", "network", "bluetooth", "wireplumber", "idle_inhibitor"],
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %B %d, %Y}",
  },
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": ["", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "tooltip-format": "{node_name} @ {volume}%",
  },
  "battery": {
    "format": "{icon} {capacity} %",
    "format-charging": "󰂄 {capacity} %",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "critical": 10,
    },
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "{time} remaining",
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰖟",
    "format-disconnected": "󰕑",
    "tooltip-format-wifi": " {essid} - ({signalStrength}%)",
    "tooltip-format-ethernet": "󰈀 {ifname} > {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
  },
  "bluetooth": {
    "format": "",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "tooltip-format": "{num_connections} connected",
    "tooltip-format-connected": "{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click-middle": "~/.config/waybar/scripts/bt-disconnect.sh",
    "interval": 2,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format": "Caffeine {status}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊",
    },
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12,
    "show-passive-items": false,
  },
  "privacy": {
    "icon-spacing": 0,
    "icon-size": 16,
    "transition-duration": 0,
    "modules": [
      {
        "type": "screenshare",
        "icon-name": "video-display-symbolic",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
      {
        "type": "audio-out",
        "icon-name": "audio-headphones-symbolic",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
      {
        "type": "audio-in",
        "icon-name": "microphone-sensitivity-high-symbolic",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
    ],
    "ignore-monitor": true,
    "ignore": [
      {
        "type": "audio-in",
        "name": "cava",
      },
      {
        "type": "screenshare",
        "name": "obs",
      },
    ],
  },
}
