[Unit]
Description=Stoat Radio Spotify voice bot
After=pipewire-pulse.service
Wants=pipewire-pulse.service
StartLimitIntervalSec=0

[Service]
ExecStart="/home/pimp/.local/share/stoat-radio/venv/bin/python" "/home/pimp/.local/share/stoat-radio/radio.py"
ExecStopPost="/home/pimp/.local/share/stoat-radio/venv/bin/python" "/home/pimp/.local/share/stoat-radio/audio.py"
Environment="XDG_CONFIG_HOME=/home/pimp/.config"
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
