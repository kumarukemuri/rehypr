[Unit]
Description=GPU Screen Recorder compact silent clips
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=/usr/bin/bash %h/.config/hypr/scripts/record.sh --run
ExecStopPost=/usr/bin/bash %h/.config/hypr/scripts/record.sh --finished
KillSignal=SIGINT
TimeoutStopSec=60s
Slice=background-graphical.slice
