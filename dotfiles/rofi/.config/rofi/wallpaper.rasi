@import "./colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Propo 12";
    text-color: @on-surface;
    background-color: @background;
}

window {
    location: center;
    anchor: center;
    width: 1200px;
    border: 0px;
    border-radius: 0px;
    background-color: @background;
}

mainbox {
    spacing: 6px;
    padding: 8px;
    background-color: @background;
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 6px;
    padding: 8px 10px;
    border-radius: 0px;
    background-color: @primary;
    text-color: @on-primary;
    children: [ "prompt", "entry" ];
}

prompt,
textbox-prompt-colon,
entry {
    background-color: inherit;
    text-color: inherit;
}

entry {
    placeholder: "Search wallpapers...";
    placeholder-color: @on-primary;
}

listview {
    columns: 6;
    lines: 3;
    fixed-height: false;
    dynamic: true;
    fixed-columns: true;
    flow: horizontal;
    spacing: 6px;
    scrollbar: false;
    background-color: @background;
}

element {
    orientation: vertical;
    spacing: 4px;
    padding: 4px;
    border-radius: 0px;
    background-color: @background;
    text-color: @on-surface;
}

element selected.normal {
    background-color: @primary;
    text-color: @on-primary;
}

element-icon {
    size: 180px;
    squared: false;
    width: 180px;
    height: 102px;
    background-color: transparent;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
