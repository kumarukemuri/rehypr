@import "./colors.rasi"

* {
    font: "Roboto 14";

    selected:               @primary;
    foreground:             @on-surface;
    border-color:           transparent;
    urgent:                 @error;
}

/*****----- Configuration -----*****/
configuration {
    modi:                   "drun";
    show-icons:             true;
    display-drun:           "";
    drun-display-format:    "{name}";
}

/*****----- Main Window -----*****/
window {
    location: center;
    anchor: center;
    width: 660px;

    margin: 0;
    padding: 0;

    border: 0;
    border-radius: 16px;
    background-color: @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                true;
    spacing:                12px;
    margin:                 0px;
    padding:                10px;
    border:                 0px solid;
    border-radius:          16px;
    border-color:           transparent;
    background-color:       @background;
    children:               [ "inputbar", "listview" ];
}

/*****----- Input Bar -----*****/
inputbar {
    spacing: 10px;
    padding: 12px 16px;
    border-radius: 12px;
    background-color: @primary;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: inherit;
    text-color: inherit;
}

textbox-prompt-colon {
    background-color: inherit;
    text-color: inherit;
}

entry {
    enabled:                true;
    background-color:       inherit;
    text-color:             @outline-variant;
    cursor:                 text;
    hide-cursor-on-empty:   true;
    placeholder:            "Search...";
    placeholder-color:      @outline-variant;
    border-radius:          12px;
}

/*****----- List View -----*****/
listview {
    columns: 3;
    lines: 8;
    cycle: true;
    spacing: 6px;
    background-color: @background;
    border-radius: 12px;
}

/*****----- Elements -----*****/
element {
    spacing: 10px;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: @background;
    text-color: @foreground;
}

element normal.normal {
    background-color:       @background;
    text-color:             @on-surface;
    border-radius:          8px;
}

element selected.normal {
    background-color:       @primary;
    text-color:             @outline-variant;
    border-color:           transparent;
    border-radius:          8px;
}

element normal.urgent {
    background-color:       @background;
    text-color:             @error;
    border-radius:          8px;
}

element selected.urgent {
    background-color:       @error;
    text-color:             @on-error;
    border-color:           transparent;
    border-radius:          8px;
}

element-icon {
    background-color:       transparent;
    text-color:             inherit;
    size:                   26px;
    cursor:                 inherit;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    highlight:              inherit;
    cursor:                 inherit;
    vertical-align:         0.5;
    horizontal-align:       0.0;
    border-radius:          8px;
}

/*****----- Message / Error -----*****/
message {
    enabled:                true;
    margin:                 0px;
    padding:                10px;
    border:                 0px solid;
    border-radius:          12px;
    background-color:       @background;
}

textbox {
    background-color:       transparent;
    text-color:             @foreground;
    vertical-align:         0.5;
    horizontal-align:       0.0;
    highlight:              none;
    border-radius:          8px;
}

error-message {
    padding:                12px;
    border:                 0px solid;
    border-radius:          12px;
    border-color:           transparent;
    background-color:       @error-container;
    text-color:             @on-error-container;
}
